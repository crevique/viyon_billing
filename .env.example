# ==============================================================================
# VIYON Billing System - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR ACTUAL CREDENTIALS.
# NEVER COMMIT YOUR .env FILE WITH REAL PASSWORDS TO GIT.
# ==============================================================================

# Database Connection (Neon PostgreSQL with Psycopg 3 driver)
# Format: postgresql+psycopg://<username>:<password>@<neon_host>/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Application Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OWNER_SETUP_TOKEN=replace-with-a-secure-one-time-owner-setup-token
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
